# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Nimble
NIMBLE_API_KEY=your-nimble-api-key-here

# Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# GitHub (for repo creation script)
GITHUB_TOKEN=your-github-token-here
GITHUB_ORG=OUT-CK
GITHUB_REPO=concert-agent

# Ticketing platform APIs (used by --ticketing-run)
# Ticketmaster: free key at developer.ticketmaster.com
TICKETMASTER_API_KEY=your-ticketmaster-api-key-here
# SeatGeek: register at seatgeek.com/account/develop
SEATGEEK_CLIENT_ID=your-seatgeek-client-id-here
SEATGEEK_CLIENT_SECRET=your-seatgeek-client-secret-here  # optional, increases rate limits
# Eventbrite: create a private token at eventbrite.com/platform/api-keys
EVENTBRITE_API_KEY=your-eventbrite-api-key-here
# StubHub: register at developer.stubhub.com
STUBHUB_CLIENT_ID=your-stubhub-client-id-here
STUBHUB_CLIENT_SECRET=your-stubhub-client-secret-here

# Logging (optional — defaults to INFO)
# LOG_LEVEL=DEBUG
